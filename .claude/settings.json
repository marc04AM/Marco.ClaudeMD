{
  "permissions": {
    "allow": [
      "Bash(dotnet build *)",
      "Bash(dotnet test *)",
      "Bash(dotnet format *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(gh issue *)",
      "Bash(gh pr *)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/secrets/*)",
      "Bash(rm -rf *)",
      "Bash(git push --force *)",
      "Bash(curl *)"
    ]
  },
  "model": "opus",
  "statusLine": {
    "type": "command",
    "command": "bash \"./.claude/statusline-command.sh\""
  },
  "planModel": "claude-opus-4-8",
  "autoMemoryEnabled": true,
  "includeEditInstructions": true,
  "respectGitignore": true
}
